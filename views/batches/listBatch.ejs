<%- include("../partials/header") %>

        <a href="/home" class="btn btn-secondary m-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-skip-backward-fill" viewBox="0 0 16 16">
                <path d="M.5 3.5A.5.5 0 0 0 0 4v8a.5.5 0 0 0 1 0V8.753l6.267 3.636c.54.313 1.233-.066 1.233-.697v-2.94l6.267 3.636c.54.314 1.233-.065 1.233-.696V4.308c0-.63-.693-1.01-1.233-.696L8.5 7.248v-2.94c0-.63-.692-1.01-1.233-.696L1 7.248V4a.5.5 0 0 0-.5-.5"/>
           </svg>
        </a>

<div class="container mt-5">

  <div class="d-flex justify-content-between align-items-center text-center mb-4">
    <h2 class="text-center fw-bold">💊 Liste Lots des médicaments</h2>
     <div class="flex-d mx-3" style="border: 1px secondary;">
      <a href="/batches/addBatch" class="btn btn-success me-2">
        <i class="bi bi-plus-circle"></i> Ajouter
      </a>
      <a href="/category/addCategory" class="btn btn-success ms-2">
        <i class="bi bi-plus-circle"></i> Catégorie
      </a>
      
    </div>
  </div>

  <!-- FLASH -->
  <% if (success && success.length > 0) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <% if (error && error.length > 0) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <div class="card shadow">
    <div class="card-body">

      <table class="table table-bordered table-hover table-striped align-middle" id="batchTable">
        <thead class="table-primary">
          <tr>
            <th>#</th>
            <th>Numéro du lot</th>
            <th>Nom du médicament</th>
            <th>Quantité initiale</th>
            <th>Stock restant</th>
            <th>Prix d'achat</th>
            <th>Prix de vente</th>
            <th>Date d'expiration</th>
            <th>Alertes</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (batches.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center">Aucun lot de médicament trouvé</td>
            </tr>
          <% } %>
          <% batches.forEach(batch => { %>
            <tr>
              <td><%= batch.id %></td>
              <td><%= batch.batchNumber %></td>

              <!-- DRUG -->
              <td><%= batch.drug.name%></td>

               <!-- QUANTITE INITIALE -->
            <td>
              <span class="badge bg-primary">
                <%= batch.quantity %>
              </span>
            </td>

            <!-- STOCK RESTANT -->
            <td>
              <% if (batch.remainingStock <= batch.alertThreshold) { %>
                  <span class="badge bg-danger">
                    <%= batch.remainingStock %>
                  </span>
              <% } else { %>
                  <span class="badge bg-success">
                    <%= batch.remainingStock %>
                  </span>
              <% } %>
            </td>

            <!-- PRIX -->
            <td><%= batch.purchasePrice %></td>
            <td><%= batch.sellingPrice %></td>

            <!-- EXPIRATION -->
            <td>
              <%= batch.expirationDate %>
            </td>
            
            <!-- ALERTES -->
            <td>
              <!-- STOCK FAIBLE -->
              <% if (batch.remainingStock <= batch.alertThreshold) { %>
                  <span class="badge bg-danger mb-1">
                    Stock faible
                  </span>
                  <br>
              <% } %>
              <!-- EXPIRATION -->
              <% 
                const today = new Date();
                const expiration = new Date(batch.expirationDate);
                const diffTime = expiration - today;
                const diffDays = Math.ceil(
                  diffTime / (1000 * 60 * 60 * 24)
                );
              %>
              <% if (expiration < today) { %>
                  <span class="badge bg-danger text-light">
                    Expiré
                  </span>
              <% } else if (diffDays <= 30) { %>
                  <span class="badge bg-warning text-light">
                    Expire bientôt
                  </span>
              <% } %>
            </td>
               
              <!-- ACTIONS -->
              <td class="text-center">

                <a href="/batches/edit/<%= batch.id %>" 
                   class="btn btn-warning btn-sm">
                  <i class="bi bi-pencil-square"></i>
                </a>

                <form action="/batches/listBatch/delete/<%= batch.id %>" 
                      method="POST" 
                      style="display:inline-block;"
                      onsubmit="return confirm('Voulez-vous Supprimer ce lot de médicament ?');">

                  <button class="btn btn-danger btn-sm">
                    <i class="bi bi-trash"></i>
                  </button>

                </form>

              </td>
            </tr>
          <% }) %>

        </tbody>
      </table>

    </div>
  </div>
</div>

<%- include("../partials/footer") %>

<script>
    $(document).ready(() => {
        $('#batchTable').DataTable(); 
    });
</script>

