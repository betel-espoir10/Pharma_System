<%- include("../partials/header") %>


<div class="container mt-4">
  <div class="card shadow">
    <div class="card-header bg-warning">
      <h3>
        Modifier Vente
      </h3>
    </div>

    <div class="card-body">
      <form action="/sales/editSale/<%= sale.id %>" method="POST">
        <div class="mb-3">
          <label>
            Méthode paiement
          </label>
          <select name="paymentMethod"
                  class="form-select">
            <option value="CASH">
              Cash
            </option>
            <option value="MOBILE_MONEY">
              Mobile Money
            </option>
            <option value="CARD">
              Carte
            </option>
          </select>
        </div>
        <div class="mb-3">
          <label>
            Statut paiement
          </label>
          <select name="paymentStatus"
                  class="form-select">
            <option value="PAID">
              Payé
            </option>
            <option value="PENDING">
              En attente
            </option>
            <option value="PARTIAL">
              Partiel
            </option>
          </select>
        </div>
        <div class="mb-3">
          <label>
            Notes
          </label>
          <textarea name="notes" class="form-control"><%= sale.notes %></textarea>
        </div>
        <button class="btn btn-success">
          Mettre à jour
        </button>
      </form>
    </div>
  </div>
</div>


<%- include("../partials/footer") %>
