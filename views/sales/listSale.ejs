<%- include("../partials/header") %>

        <a href="/home" class="btn btn-secondary m-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-skip-backward-fill" viewBox="0 0 16 16">
                <path d="M.5 3.5A.5.5 0 0 0 0 4v8a.5.5 0 0 0 1 0V8.753l6.267 3.636c.54.313 1.233-.066 1.233-.697v-2.94l6.267 3.636c.54.314 1.233-.065 1.233-.696V4.308c0-.63-.693-1.01-1.233-.696L8.5 7.248v-2.94c0-.63-.692-1.01-1.233-.696L1 7.248V4a.5.5 0 0 0-.5-.5"/>
           </svg>
        </a>


<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center text-center mb-4">
      <h2 class="text-center fw-bold">Liste des ventes</h2>
      <a href="/sales/addSale" class="btn btn-success">
         Nouvelle Vente
      </a>
    </div>

   <div class="card shadow">
    <div class="card-body">
      <table class="table table-bordered table-hover">
        <thead class="table-primary">
          <tr>
            <th>N° Facture</th>
            <th>Nom du client</th>
            <th>Le Caissier.e</th>
            <th>Total payé</th>
            <th>Moyen de Paiement</th>
            <th>Statut</th>
            <th>Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% sales.forEach(sale => { %>
            <tr>
                <td><%= sale.invoiceNumber %></td>
                <td><%= sale.customer.name %></td>
                <td><%= sale.user ? sale.user.name : "Inconnu" %></td>
                <td><%= sale.totalAmount %></td>
                <td><%= sale.paymentMethod %></td>
                  <td>
                      <% if (sale.paymentStatus === "PAID") { %>
                        <span class="badge bg-success">
                          PAYÉ
                        </span>
                      <% } else { %>
                        <span class="badge bg-warning text-dark">
                          EN ATTENTE
                        </span>
                      <% } %>
                  </td>
                  <td>
                    <span><%= sale.createdAt.toLocaleDateString("fr-FR") %></span>
                      <br>
                        <%= sale.createdAt.toLocaleTimeString("fr-FR", {
                          hour: "2-digit",
                          minute: "2-digit",
                          second: "2-digit"
                        }) %>
                  </td>

                  <td>                 
                      <!-- MODIFIER -->
                      <a href="/sales/editSale/<%= sale.id %>" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil-square"></i>
                      </a>

                      <a href="/sales/showSale/<%= sale.id %>" class="btn btn-info btn-sm">
                        <i class="bi bi-eye-fill"></i>
                      </a>

                      <!-- FACTURE PDF -->
                      <a href="/sales/invoice/<%= sale.id %>"
                          class="btn btn-primary btn-sm"
                          target="_blank">                     
                        <i class="bi bi-printer"></i>
                      </a>
                  </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>


<%- include("../partials/footer") %>
