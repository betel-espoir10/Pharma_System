<div class="row g-4">

    <!-- CHIFFRE AFFAIRES -->
    <div class="col-xl-3 col-md-6">

        <div class="dashboard-card card-blue">

            <div class="card-icon">
                💰
            </div>

            <h3 class="counter">
                <%= totalRevenue || 0 %>
            </h3>

            <p>Chiffre d'affaires</p>

        </div>

    </div>

    <!-- PROFIT -->

    <div class="col-xl-3 col-md-6">

        <div class="dashboard-card card-green">

            <div class="card-icon">
                📈
            </div>

            <h3 class="counter">
                <%= profit || 0 %>
            </h3>

            <p>Profit</p>

        </div>

    </div>

    <!-- VENTES -->

    <div class="col-xl-3 col-md-6">

        <div class="dashboard-card card-orange">

            <div class="card-icon">
                🧾
            </div>

            <h3 class="counter">
                <%= totalSales || 0 %>
            </h3>

            <p>Ventes</p>

        </div>

    </div>

    <!-- ACHATS -->

    <div class="col-xl-3 col-md-6">

        <div class="dashboard-card card-red">

            <div class="card-icon">
                📦
            </div>

            <h3 class="counter">
                <%= totalPurchases || 0 %>
            </h3>

            <p>Achats</p>

        </div>

    </div>

    <!-- PRODUITS -->

    <div class="col-xl-3 col-md-6">

        <div class="dashboard-card card-purple">

            <div class="card-icon">
                💊
            </div>

            <h3 class="counter">
                <%= totalDrugs || 0 %>
            </h3>

            <p>Médicaments</p>

        </div>

    </div>

    <!-- STOCK -->

    <div class="col-xl-3 col-md-6">

        <div class="dashboard-card card-cyan">

            <div class="card-icon">
                🏪
            </div>

            <h3 class="counter">
                <%= totalStock || 0 %>
            </h3>

            <p>Stock Disponible</p>

        </div>

    </div>

    <!-- CLIENTS -->

    <div class="col-xl-3 col-md-6">

        <div class="dashboard-card card-dark">

            <div class="card-icon">
                👥
            </div>

            <h3 class="counter">
                <%= totalCustomers || 0 %>
            </h3>

            <p>Clients</p>

        </div>

    </div>

    <!-- UTILISATEURS -->

    <div class="col-xl-3 col-md-6">

        <div class="dashboard-card card-pink">

            <div class="card-icon">
                👨‍💼
            </div>

            <h3 class="counter">
                <%= totalUsers || 0 %>
            </h3>

            <p>Utilisateurs</p>

        </div>

    </div>

</div>