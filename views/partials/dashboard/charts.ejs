<div class="row mt-4">

    <!-- EVOLUTION DES VENTES -->
    <div class="col-lg-8 mb-4">
        <div class="card shadow border-0">
            <div class="card-header">
                <h5 class="mb-0">
                    📈 Evolution des ventes
                </h5>
            </div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="salesChart"></canvas>
                    <p id="salesChartEmpty" class="chart-empty-state d-none">Aucune vente ou aucun achat enregistré sur les 7 derniers jours.</p>
                </div>
            </div>
        </div>
    </div>

        <!-- REPARTITION DES VENTES -->
    <div class="col-lg-4 mb-4">
        <div class="card shadow border-0">
            <div class="card-header">
                <h5 class="mb-0">
                    💰 Répartition financière
                </h5>
            </div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="profitChart"></canvas>
                    <p id="profitChartEmpty" class="chart-empty-state d-none">Aucune donnée financière à afficher pour le moment.</p>
                </div>
            </div>
        </div>
    </div>

</div>
