<%- include("../partials/header") %>

   <style>
    /* IMPORTANT */
    .iti {
      width: 100%;
    }
    .iti__flag {
    background-image: url("https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.0/build/img/flags.webp");
    }
    .iti input {
      width: 100%;
      height: 48px;
      padding-left: 90px !important;
    }
  </style>

<div class="container my-5">
  <div class="card shadow">  
    <div class="card-header bg-primary text-white">
      <h4 class="text-center fw-bold"> Ajouter un Client</h4>
    </div>
    <div class="card-body">
      <!-- FLASH MESSAGE -->
      <% if (error.length > 0) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form action="/customers/addCustomer" method="POST">

        <!-- NAME -->
        <div class="mb-3">
          <label class="form-label fw-bold">Nom du client :</label>
          <input type="text" name="name" class="form-control" required>
        </div>

        <!-- PHONE -->
        <div class="mb-3">
          <label class="form-label fw-bold"> Téléphone :</label>
          <input
              type="tel"
              id="phone"
              class="form-control"
              required
            >
            <input
              type="hidden"
              id="fullPhone"
              name="phone"
            >        
        </div>
        
        <!-- ADRESS -->
        <div class="mb-3">
          <label class="form-label fw-bold"">Adresse :</label>
          <input type="text" name="address" class="form-control" required>
        </div>

        <!-- BUTTON -->
        <button type="submit" class="btn btn-success">
          ✅ Enregistrer
        </button>
        <a href="/customers/listCustomer" class="btn btn-secondary">
          ⬅️ Retour
        </a>
      </form>
    </div>
  </div>
</div>
<!-- JS -->

 <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.0/build/js/intlTelInput.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {

    const phoneInput = document.querySelector("#phone");
    const iti = window.intlTelInput(phoneInput, {
        initialCountry: "td",
        separateDialCode: true
    });
    const form = document.querySelector("form");
    form.addEventListener("submit", function () {
        document.getElementById("fullPhone").value =
            iti.getSelectedCountryData().dialCode +
            phoneInput.value;
    });
});
</script>
