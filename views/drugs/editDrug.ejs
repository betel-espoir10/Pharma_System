<%- include("../partials/header") %>

<div class="container mt-5">
  <div class="card shadow">

    <div class="card-header bg-warning">
      <h4 class="text-center fw-bold">✏️ Modifier le médicament</h4>
    </div>

    <div class="card-body">

      <% if (error && error.length > 0) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form action="/drugs/edit/<%= drug.id %>" method="POST">

        <!-- NAME -->
        <div class="mb-3">
          <label class="form-label fw-bold">Nom du médicament :</label>
          <input type="text" name="name" class="form-control"
                 value="<%= drug.name %>" required>
        </div>

        <!-- DESCRIPTION -->
        <div class="mb-3">
          <label class="form-label fw-bold">Description :</label>
          <textarea name="description" class="form-control">
             <%= drug.description %></textarea>
        </div>

        <!-- DOSAGE -->
        <div class="mb-3">
          <label class="form-label fw-bold">Dosage :</label>
          <input type="number" step="0.01" name="dosage"
                 class="form-control"
                 value="<%= drug.dosage %>" required>
        </div>

        <!-- FORM -->
        <div class="mb-3">
          <label class="form-label fw-bold">Forme du médicament :</label>
          <select name="form" class="form-select" required>
            <option value="Comprimé" <%= drug.form === "Comprimé" ? "selected" : "" %>>Comprimé</option>
            <option value="Sirop" <%= drug.form === "Sirop" ? "selected" : "" %>>Sirop</option>
            <option value="Injection" <%= drug.form === "Injection" ? "selected" : "" %>>Injection</option>
          </select>
        </div>

        <!-- CATEGORY -->
        <div class="mb-3">
          <label class="form-label fw-bold">Catégorie :</label>
          <select name="categoryId" class="form-select" required>

            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>"
                <%= drug.categoryId === cat.id ? "selected" : "" %>>
                <%= cat.name %>
              </option>
            <% }) %>

          </select>
        </div>

        <!-- MANUFACTURER -->
        <div class="mb-3">
          <label class="form-label fw-bold">Fabricant :</label>
          <select name="manufacturerId" class="form-select" required>

            <% manufacturers.forEach(man => { %>
              <option value="<%= man.id %>"
                <%= drug.manufacturerId === man.id ? "selected" : "" %>>
                <%= man.name %>
              </option>
            <% }) %>

          </select>
        </div>

        <!-- BUTTONS -->
        <button class="btn btn-success">💾 Mettre à jour</button>
        <a href="/drugs/listDrug" class="btn btn-secondary">⬅️ Retour</a>

      </form>

    </div>
  </div>
</div>
