<%- include("../partials/header") %>


<div class="container my-5">
  <div class="card shadow">
    
    <div class="card-header bg-primary text-white">
      <h4 class="text-center fw-bold">💊 Ajouter un médicament</h4>
    </div>

    <div class="card-body">

      <!-- FLASH MESSAGE -->
      <% if (error.length > 0) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form action="/drugs/addDrug" method="POST">

        <!-- NAME -->
        <div class="mb-3">
          <label class="form-label fw-bold">Nom du médicament :</label>
          <input type="text" name="name" class="form-control" required>
        </div>

        <!-- DESCRIPTION -->
        <div class="mb-3">
          <label class="form-label fw-bold"">Description :</label>
          <textarea name="description" class="form-control"></textarea>
        </div>

        <!-- DOSAGE -->
        <div class="mb-3">
          <label class="form-label fw-bold"">Dosage :</label>
          <input type="number" step="0.01" name="dosage" class="form-control" required>
        </div>

        <!-- FORM -->
        <div class="mb-3">
          <label class="form-label fw-bold"">Forme :</label>
          <select name="form" class="form-select" required>
            <option value="">-- Choisir --</option>
            <option value="Comprimé">Comprimé</option>
            <option value="Sirop">Sirop</option>
            <option value="Injection">Injection</option>
          </select>
        </div>

        <!-- CATEGORY -->
        <div class="mb-3">
          <label class="form-label fw-bold"">Catégorie :</label>
          <select name="categoryId" class="form-select" required>
            <option value="">-- Choisir une catégorie --</option>

                  <% if (categories && categories.length > 0) { %>
                        <% categories.forEach(category => { %>
                            <option value="<%= category.id %>"><%= category.name %></option>
                        <% }) %>
                     <% } %>
          </select>
        </div>

        <!-- MANUFACTURER -->
        <div class="mb-3">
          <label class="form-label fw-bold"">Fabricant :</label>
          <select name="manufacturerId" class="form-select" required>
            <option value="">-- Choisir un fabricant --</option>
            <% if (manufacturers && manufacturers.length > 0) { %>
            <% manufacturers.forEach(man => { %>
              <option value="<%= man.id %>"><%= man.name %></option>
             <% }) %>
            <% } %> 
          </select>
        </div>

        <!-- BUTTON -->
        <button type="submit" class="btn btn-success">
          ✅ Enregistrer
        </button>

        <a href="/drugs/listDrug" class="btn btn-secondary">
          ⬅️ Retour
        </a>
      </form>
    </div>
  </div>
</div>

