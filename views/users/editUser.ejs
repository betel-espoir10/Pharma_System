<%- include("../partials/header") %>
<%- include("../partials/flash") %>

<div class="container mt-5">
  <div class="card shadow">

    <div class="card-header bg-warning">
      <h4 class="text-center fw-bold">✏️ Modifier les Infos d'un utilisateur</h4>
    </div>

    <div class="card-body">

      <% if (error && error.length > 0) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form action="/users/editUser/<%= user.id %>" method="POST">

        <!-- NAME -->
        <div class="mb-3">
          <label class="form-label fw-bold">Nom :</label>
          <input type="text" name="name" class="form-control"
                 value="<%= user.name %>" required>
        </div>

        <!-- EMAIL -->
        <div class="mb-3">
          <label class="form-label fw-bold">Email :</label>
          <input type="email" name="email" class="form-control" value="<%= user.email %>" required>
        </div>

        <!-- STATUS -->
        <div class="mb-3">
          <label class="form-label fw-bold">Status:</label>
          <select name="status" class="form-select" required>
            <option value="active" <%= user.status === "ACTIVE" ? "selected" : "" %>>ACTIVE</option>
            <option value="inactive" <%= user.status === "INACTIVE" ? "selected" : "" %>>INACTIVE</option>
          </select>
        </div>

        <!-- ROLE -->
        <div class="mb-3">
          <label class="form-label fw-bold">Role :</label>
          <select name="roleId" class="form-select" required>

            <% roles.filter(role => role.name !== "ADMIN")
                .forEach(role => { %>
               <option
                    value="<%= role.id %>"
                    <%= user.roleId === role.id ? "selected": "" %>>
                    <%= role.name %>
               </option>
            <% }) %>
          </select>
        </div>

        <!-- BUTTONS -->
        <button class="btn btn-success">💾 Mettre à jour</button>
        <a href="/users/listUser" class="btn btn-secondary">⬅️ Retour</a>

      </form>

    </div>
  </div>
</div>



<%- include("../partials/footer") %>
