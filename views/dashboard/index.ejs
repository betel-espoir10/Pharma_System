<%- include("../partials/header") %>

        <a href="/home" class="btn btn-secondary m-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-skip-backward-fill" viewBox="0 0 16 16">
                <path d="M.5 3.5A.5.5 0 0 0 0 4v8a.5.5 0 0 0 1 0V8.753l6.267 3.636c.54.313 1.233-.066 1.233-.697v-2.94l6.267 3.636c.54.314 1.233-.065 1.233-.696V4.308c0-.63-.693-1.01-1.233-.696L8.5 7.248v-2.94c0-.63-.692-1.01-1.233-.696L1 7.248V4a.5.5 0 0 0-.5-.5"/>
           </svg>
        </a>

<div class="main-content p-4">
    <div class="container-fluid">

        <!-- TITLE -->
        <div class="mb-4">
            <h2 class="fw-bold">
                <i class="fa fa-chart-line text-primary"></i>
                Dashboard Journalière
            </h2>
        </div>

        <!-- STATISTIQUES -->
        <div class="row">
            <!-- SALES -->
            <div class="col-md-3 mb-4">
                <div class="card shadow border-0">
                    <div class="card-body">
                        <h6 class="text-muted">
                            Chiffre d'affaires
                        </h6>
                        <h3 class="fw-bold text-success">
                            <%= totalSales %> $
                        </h3>
                    </div>
                </div>
            </div>

            <!-- PURCHASES -->
            <div class="col-md-3 mb-4">
                <div class="card shadow border-0">
                    <div class="card-body">
                        <h6 class="text-muted">
                            Total Achats
                        </h6>
                        <h3 class="fw-bold text-danger">
                            <%= totalPurchases %> $
                        </h3>
                    </div>
                </div>
            </div>

            <!-- PROFIT -->
            <div class="col-md-3 mb-4">
                <div class="card shadow border-0">
                    <div class="card-body">
                        <h6 class="text-muted">
                            Bénéfice
                        </h6>
                        <h3 class="fw-bold text-primary">
                            <%= profit %> $
                        </h3>
                    </div>
                </div>
            </div>

            <!-- TODAY SALES -->
            <div class="col-md-3 mb-4">
                <div class="card shadow border-0">
                    <div class="card-body">
                        <h6 class="text-muted">
                            Ventes du Jour
                        </h6>
                        <h3 class="fw-bold text-dark">
                            <%= todaySales %> $
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- ALERTES -->
        <div class="row">
            <!-- STOCK FAIBLE -->
            <div class="col-md-6 mb-4">
                <div class="card shadow border-0">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">
                            <i class="fa fa-exclamation-triangle"></i>
                            Stock Faible
                        </h5>
                    </div>
                    <div class="card-body">
                        <% lowStockBatches.forEach(batch => { %>
                            <div class="alert alert-warning">
                                <strong>
                                    <%= batch.drug.name %>
                                </strong>
                                :
                                Stock restant
                                <%= batch.remainingStock %>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <!-- EXPIRES -->
            <div class="col-md-6 mb-4">
                <div class="card shadow border-0">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">
                            <i class="fa fa-calendar-times"></i>
                            Produits Expirés
                        </h5>
                    </div>
                    <div class="card-body">
                        <% expiredBatches.forEach(batch => { %>
                            <div class="alert alert-danger">
                                <strong>
                                    <%= batch.drug.name %>
                                </strong>
                                expiré
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>

        <!-- VENTES ET ACHATS -->
        <div class="row">
            <!-- DERNIERES VENTES -->
            <div class="col-md-6">
                <div class="card shadow border-0">
                    <div class="card-header bg-primary text-white">
                        Dernières Ventes
                    </div>
                    <div class="card-body">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Facture</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentSales.forEach(sale => { %>
                                    <tr>
                                        <td>
                                            <%= sale.invoiceNumber %>
                                        </td>
                                        <td>
                                            <%= sale.totalAmount %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- DERNIERS ACHATS -->
            <div class="col-md-6">
                <div class="card shadow border-0">
                    <div class="card-header bg-success text-white">
                        Derniers Achats
                    </div>
                    <div class="card-body">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Facture</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                              <% recentPurchases.forEach(purchase => { %>
                                    <tr>
                                        <td>
                                            <%= purchase.invoiceNumber %>
                                        </td>
                                        <td>
                                            <%= purchase.totalAmount %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
